APP_NAME="SSO Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sso.yado.my.id
ASSET_URL=http://sso.yado.my.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_READ_HOST=127.0.0.1
DB_WRITE_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_sso
DB_USERNAME=postgres
DB_PASSWORD=

# Leftover from the old MySQL - ONLY used once by `php artisan db:migrate-to-pgsql` to
# read the old data before fully moving to Postgres. Safe to leave empty/remove if
# there is no old data to migrate (fresh install).
MYSQL_LEGACY_HOST=127.0.0.1
MYSQL_LEGACY_PORT=3306
MYSQL_LEGACY_DATABASE=db_sso
MYSQL_LEGACY_USERNAME=root
MYSQL_LEGACY_PASSWORD=

# Only used by docker/compose.standalone.yml - the address served by Caddy.
# Local testing/use: keep the default (http://localhost).
# Public deploy: enter the real domain without a scheme, e.g. "sso.yado.my.id" - Caddy
# provisions HTTPS via Let's Encrypt, no manual setup needed.
# IMPORTANT: do not put a port here (e.g. "http://localhost:8080") if HTTP_PORT
# is changed from the default - set the host ports via HTTP_PORT/HTTPS_PORT below only.
CADDY_SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@yado.my.id"
MAIL_FROM_NAME="SSO Yado"

RESEND_API_KEY=re_***

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@yado.my.id
ADMIN_PASSWORD=change-me-in-production

# Deploy via SSH from local (for make remote-deploy / make remote-update)
SERVER_HOST=
SSH_KEY_PATH=~/.ssh/your-key.pem
SERVER_USER=ubuntu
SERVER_PATH=/var/www/sso
